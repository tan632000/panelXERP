# Backend — local dev (host npm run start:dev or Docker via compose)
# Copy: cp .env.example .env
# Shared identity/plugins: ../.env — see ../.env.example
# Database (host ports below; Docker uses root .env DB_* via compose)

NODE_ENV=development
PORT=8080
APP_NAME=erp-api
TENANT_ID=panelxerp
SEED_EMAIL_DOMAIN=example.com
SEED_SCOPE=all

# --- Email ---
# Sender address every transactional mail goes out from (SES and SMTP alike).
# MAIL_FROM_EMAIL overrides it; SES_FROM_EMAIL stays the fallback.
SES_FROM_EMAIL=noreply@example.com
# MAIL_FROM_EMAIL=noreply@example.com
# Transport. Unset: smtp when SMTP_HOST is set, otherwise ses (LocalStack locally via AWS_ENDPOINT).
# Force one with MAIL_DRIVER=ses|smtp.
# MAIL_DRIVER=smtp
# Mailtrap sandbox inbox — credentials from the inbox's "SMTP Settings" tab.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
CORS_ORIGIN=http://localhost:3000
# Absolute origin the reset-password mail links to. Defaults to CORS_ORIGIN.
# APP_WEB_URL=http://localhost:3000
# Minutes a password reset link stays usable (default 60).
# PASSWORD_RESET_TTL_MINUTES=60

# Database (host ports — DB_NAME/USER/PASSWORD synced from ../.env by make env)
DATABASE_URL=postgresql://erp_user:erp_pass_dev@localhost:15432/panelxerp
DB_HOST=localhost
DB_PORT=15432
DB_NAME=panelxerp
DB_USER=erp_user
DB_PASSWORD=erp_pass_dev
RUN_MIGRATIONS=false

REDIS_URL=redis://localhost:16379
REDIS_HOST=localhost
REDIS_PORT=16379

JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Admin account password used by the seed (dev-only example value; production refuses it)
SEED_ADMIN_PASSWORD=ChangeMe-Dev-Only-123


AWS_REGION=ap-southeast-1
AWS_ENDPOINT=http://localhost:14566
# Optional: browser-reachable S3 URL when AWS_ENDPOINT is a Docker-internal host (compose sets localhost:14566).
# AWS_S3_PUBLIC_ENDPOINT=http://localhost:14566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_FORCE_PATH_STYLE=true
AWS_S3_BUCKET=erp-files
AWS_S3_LOG_BUCKET=erp-logs

LOG_STORAGE_MODE=file
LOG_DIR=logs
LOG_RETENTION_DAYS=90
LOG_LEVEL=debug
LOG_FLUSH_INTERVAL_MS=60000
LOG_SERVICE_NAME=erp-backend
LOG_TIMEZONE_OFFSET=+07:00
AWS_CLOUDWATCH_ENABLED=false
AWS_CLOUDWATCH_LOG_GROUP=/erp/development/app
AWS_CW_AUDIT_GROUP=/erp/development/audit
AWS_CW_ACTIVITIES_GROUP=/erp/development/activities
