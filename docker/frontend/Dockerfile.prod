FROM node:24.22.1-alpine AS builder

WORKDIR /app

RUN apk add --no-cache libc6-compat

ARG NEXT_PUBLIC_API_URL=/api/v1
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_APP_DESCRIPTION
ARG NEXT_PUBLIC_APP_SHORT_NAME
ARG NEXT_PUBLIC_TENANT_ID
ARG NEXT_PUBLIC_APP_LOGO_URL
ARG NEXT_PUBLIC_COMPANY_NAME_VI
ARG NEXT_PUBLIC_COMPANY_NAME_EN
ARG NEXT_PUBLIC_COMPANY_SHORT_NAME_VI
ARG NEXT_PUBLIC_COMPANY_SHORT_NAME_EN
ARG NEXT_PUBLIC_COMPANY_ADDRESS_VI
ARG NEXT_PUBLIC_COMPANY_ADDRESS_EN
ARG NEXT_PUBLIC_COMPANY_PHONE
ARG NEXT_PUBLIC_COMPANY_TAX_CODE

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME}
ENV NEXT_PUBLIC_APP_DESCRIPTION=${NEXT_PUBLIC_APP_DESCRIPTION}
ENV NEXT_PUBLIC_APP_SHORT_NAME=${NEXT_PUBLIC_APP_SHORT_NAME}
ENV NEXT_PUBLIC_TENANT_ID=${NEXT_PUBLIC_TENANT_ID}
ENV NEXT_PUBLIC_APP_LOGO_URL=${NEXT_PUBLIC_APP_LOGO_URL}
ENV NEXT_PUBLIC_COMPANY_NAME_VI=${NEXT_PUBLIC_COMPANY_NAME_VI}
ENV NEXT_PUBLIC_COMPANY_NAME_EN=${NEXT_PUBLIC_COMPANY_NAME_EN}
ENV NEXT_PUBLIC_COMPANY_SHORT_NAME_VI=${NEXT_PUBLIC_COMPANY_SHORT_NAME_VI}
ENV NEXT_PUBLIC_COMPANY_SHORT_NAME_EN=${NEXT_PUBLIC_COMPANY_SHORT_NAME_EN}
ENV NEXT_PUBLIC_COMPANY_ADDRESS_VI=${NEXT_PUBLIC_COMPANY_ADDRESS_VI}
ENV NEXT_PUBLIC_COMPANY_ADDRESS_EN=${NEXT_PUBLIC_COMPANY_ADDRESS_EN}
ENV NEXT_PUBLIC_COMPANY_PHONE=${NEXT_PUBLIC_COMPANY_PHONE}
ENV NEXT_PUBLIC_COMPANY_TAX_CODE=${NEXT_PUBLIC_COMPANY_TAX_CODE}
ENV API_INTERNAL_URL=http://backend:8080
ENV HUSKY=0

# next build forks a worker for the TypeScript pass that needs well over 1GB and
# dies with SIGABRT on a small server. Types are verified by `make typecheck`
# (tsc --noEmit) in CI and locally, so the image build skips the pass entirely.
# Set to "false" to type-check here too — only on a builder with 4GB+ free.
ARG NEXT_SKIP_TYPE_CHECK=true
ENV NEXT_SKIP_TYPE_CHECK=${NEXT_SKIP_TYPE_CHECK}

# V8 defaults to about half of system RAM, which is under 1GB on a 2GB box.
# This is a ceiling, not a reservation — keep it near RAM, not far above it, or
# the build crawls through swap instead of failing fast.
ARG NODE_BUILD_MEMORY=2048
ENV NODE_OPTIONS=--max-old-space-size=${NODE_BUILD_MEMORY}

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

FROM node:24.22.1-alpine

WORKDIR /app

RUN apk add --no-cache curl libc6-compat

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

CMD ["node", "server.js"]
