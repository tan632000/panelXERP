# Production env — https://erp.example.com/
# On the server:  cp .env.production.example .env.production
# Then replace every CHANGE_ME.
#
#   make setup-prod     # first time / rebuild + start (HTTP until cert exists)
#   make certbot-init   # Let's Encrypt, then nginx switches to HTTPS
#   make build-prod     # rebuild images only
#   make up-prod        # start without rebuild
#
# DNS: A record erp.example.com → EC2 Elastic IP
# Security group: TCP 80 and 443. Do not expose 3000/8080/5432/6379.

# --- Identity ---
TENANT_ID=panelxerp
APP_DISPLAY_NAME=panelXERP
APP_SHORT_NAME=HP
APP_DESCRIPTION=panelXERP — Electrical panel design & installation
SEED_EMAIL_DOMAIN=example.com
SES_FROM_EMAIL=noreply@example.com
# Transport: leave unset for SES (needs the AWS keys below). Set SMTP_HOST to send over SMTP instead.
# MAIL_DRIVER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SEED_SCOPE=all

# --- Company (letterhead, PDF, stamps — FE build) ---
# Legal identity printed on every document. *_EN falls back to *_VI when unset.
# Logo: replace frontend/public/brand/logo.svg, or set NEXT_PUBLIC_APP_LOGO_URL.
COMPANY_NAME_VI=PANELXERP DEMO COMPANY
COMPANY_NAME_EN=PANELXERP DEMO CO., LTD
COMPANY_SHORT_NAME_VI=panelXERP Demo Company
COMPANY_SHORT_NAME_EN=panelXERP Demo Company
COMPANY_ADDRESS_VI=Số 1 Đường Demo, Hà Nội
COMPANY_ADDRESS_EN=1 Demo Street, Hanoi
COMPANY_PHONE=+84 24 0000 0000
COMPANY_TAX_CODE=0000000000

# --- Database / Redis (use strong unique values; URL-encode special chars in passwords) ---
DB_NAME=panelxerp
DB_USER=erp_user
DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- JWT (backend refuses to start in production if these are empty, CHANGE_ME or shorter than 32 chars) ---
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Admin account password for the first seed (at least 12 chars; the seed refuses the dev example value)
SEED_ADMIN_PASSWORD=CHANGE_ME


# Browser origin (no trailing slash, no :443)
CORS_ORIGIN=https://erp.example.com

# Let's Encrypt (required for make certbot-init)
APP_HOST=erp.example.com
CERTBOT_EMAIL=cong.bv@haposoft.com
# CERTBOT_STAGING=1

# Nginx basic auth (empty user/password = disabled)
BASIC_AUTH_USER=panelxerp
BASIC_AUTH_PASSWORD=CHANGE_ME

# Same-origin API via nginx (/api → backend). Do not bake the domain into the client.
NEXT_PUBLIC_API_URL=/api/v1

# --- AWS S3 ---
# Put real keys only in server .env (gitignored). Never commit them.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=panelxerp-files
AWS_S3_LOG_BUCKET=panelxerp-files
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# --- Plugins (omit or empty = all catalog plugins) ---
# Default: all registered plugins. Set this only to restrict which ones load.
# Example (sales without procurement): ENABLED_PLUGINS=master-data,sales
# ENABLED_FEATURES=

# --- Build tuning (only matters when the server builds its own images) ---
# `next build` forks a TypeScript worker that needs well over 1GB and aborts
# with SIGABRT on a small server. Types are already gated by `make typecheck`
# in CI, so the image build skips the pass. Set to false only on a 4GB+ builder.
NEXT_SKIP_TYPE_CHECK=true
# Heap ceiling (MB) for the build. V8 otherwise defaults to about half of RAM.
# Keep it near the box's RAM — far above it just means thrashing in swap.
NODE_BUILD_MEMORY=2048
