# Frontend — optional overrides (host npm run dev or Docker via compose)
# Copy: cp .env.example .env
# Shared vars (identity, plugins): ../.env — see ../.env.example
# Theme defaults: frontend/src/core/theme/theme.tokens.ts (override below if needed)

# Dev server port
PORT=3000

# API (default: http://localhost:8080/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Branding
# NEXT_PUBLIC_APP_LOGO_URL=https://cdn.example.com/logo.svg

# Theme (hex, no quotes)
# NEXT_PUBLIC_THEME_PRIMARY_COLOR=1a2a5e
# NEXT_PUBLIC_THEME_PRIMARY_HOVER=253a7e
# NEXT_PUBLIC_THEME_PRIMARY_LIGHT=e8edf8
# NEXT_PUBLIC_THEME_SIDEBAR_BG=ffffff
# NEXT_PUBLIC_THEME_SIDEBAR_TEXT=111827
# NEXT_PUBLIC_THEME_SURFACE_BG=eef0f3
