# =============================================================================
# ERP — shared env (Docker Compose + cross-service identity)
# Copy: cp .env.example .env
# Backend-only: backend/.env.example | Frontend overrides: frontend/.env.example
# =============================================================================

# --- Identity (BE + FE) ---
TENANT_ID=panelxerp
APP_DISPLAY_NAME=panelXERP
APP_SHORT_NAME=HP
APP_DESCRIPTION=panelXERP — Electrical panel design & installation

# --- Company (letterhead, PDF, stamps — FE build) ---
# Legal identity printed on every document. *_EN falls back to *_VI when unset.
# Logo: replace frontend/public/brand/logo.svg, or set NEXT_PUBLIC_APP_LOGO_URL.
COMPANY_NAME_VI=PANELXERP DEMO COMPANY
COMPANY_NAME_EN=PANELXERP DEMO CO., LTD
COMPANY_SHORT_NAME_VI=panelXERP Demo Company
COMPANY_SHORT_NAME_EN=panelXERP Demo Company
COMPANY_ADDRESS_VI=Số 1 Đường Demo, Hà Nội
COMPANY_ADDRESS_EN=1 Demo Street, Hanoi
COMPANY_PHONE=+84 24 0000 0000
COMPANY_TAX_CODE=0000000000

# --- Database (Docker Compose — default erp_platform if unset) ---
DB_NAME=panelxerp
DB_USER=erp_user
DB_PASSWORD=erp_pass_dev

# --- Email (localstack init + backend) ---
# Sender address every transactional mail goes out from.
SES_FROM_EMAIL=noreply@example.com
# Transport (SES by default, or SMTP/Mailtrap): set MAIL_DRIVER and SMTP_* in backend/.env —
# compose passes backend/.env straight through, so they do not belong here.

# --- Plugins (BE + FE — make restart, no rebuild) ---
# Default: all registered plugins. Set this only to restrict which ones load.
# Example (sales without procurement): ENABLED_PLUGINS=master-data,sales

# --- Features (optional — default: all enabled) ---
# ENABLED_FEATURES=company,product,...,rfq,quotation,order,sample-order,tooling-order,delivery-plan,reports
# Legacy alias: sales-order is accepted and mapped to order
# Example without mold: ENABLED_FEATURES=company,product,material,rfq,quotation,order

# --- Customer fork example ---
# TENANT_ID=customer-a
# APP_DISPLAY_NAME=Acme ERP
# APP_SHORT_NAME=AC
# APP_DESCRIPTION=Acme Manufacturing ERP
# DB_NAME=erp_platform
# SES_FROM_EMAIL=noreply@example.com
# COMPANY_NAME_VI=CÔNG TY TNHH ACME
# COMPANY_ADDRESS_VI=...
# COMPANY_PHONE=...
# COMPANY_TAX_CODE=...

# --- Local stack identity (only matters when running several worktrees at once) ---
# compose.yml hard-codes nothing any more: container names carry this suffix and
# every published port below is a variable. Leave both blocks at the defaults in
# the main checkout; in a second worktree pick a suffix and shift all five ports
# (e.g. +100) so the two stacks never collide. Container-internal ports never
# change, so nothing inside the network cares. Volumes and the network are
# already scoped by the Compose project name (the directory name), so each
# worktree keeps its own database.
#
#   Worktree example:  STACK_SUFFIX=-dpx  PG_PORT=15532  ...  FRONTEND_PORT=3100
STACK_SUFFIX=
PG_PORT=15432
REDIS_PORT=16379
LOCALSTACK_PORT=14566
BACKEND_PORT=8080
FRONTEND_PORT=3000
